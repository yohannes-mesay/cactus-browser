      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": 180,
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
