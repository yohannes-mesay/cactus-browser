{
  "name": "Cactus Browser",
  "short_name": "Cactus",
  "description": "Native Linux web browser — Rust, WebKitGTK, privacy by default.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f2ebe1",
  "theme_color": "#14110e",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
